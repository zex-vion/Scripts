task.spawn(function()
  local tick = 0
  local lastSkip = 0
  while engineAlive() do
    tick = tick + 1
    if tick % 16 == 0 then
      pcall(function()
        LocalPlayer:SetAttribute("OwnsQuickRollGamePass", true)
        LocalPlayer:SetAttribute("OwnsAutoRollGamePass", true)
      end)
    end
    local drawing, spinning = false, false
    pcall(function() drawing = (builderStore :: any).Drawing() end)
    pcall(function() spinning = (builderStore :: any).Spinning() end)
    if (drawing or spinning) and getenv().FreeSkip_On == true and (os.clock() - lastSkip > 0.4) then
      lastSkip = os.clock()
      pcall(function() (builderStore :: any).SkipDraw() end)
      pcall(function() storeAny.FinishDraw() end)
      pcall(function()
        local cp = storeAny.CategoryPop()
        if type(cp) == "table" then cp.Duration = 0 end
      end)
    end
    if getenv().FreeAutoRoll == true and not drawing and not spinning then
      local cards = nil
      pcall(function() cards = (builderStore :: any).Draw().Cards or {} end)
      local hit = false
      local hitName = ""
      if type(cards) == "table" then
        for _, c in ipairs(cards) do
          local h, n = cardHit(c)
          if h then hit = true hitName = n break end
        end
      end
      if hit then
        getenv().FreeAutoRoll = false
        pcall(function() autoToggle:Set(false) end)
        print("[free-auto] STOP: " .. hitName)
        pcall(function() storeAny.SetMessage("AUTO STOP: " .. hitName) end)
      else
        local canRoll = false
        pcall(function() canRoll = (builderStore :: any).CanRoll() end)
        if canRoll then
          pcall(function() storeAny.Roll() end)
          task.wait(0.6)
        else
          task.wait(0.5)
        end
      end
    end
    if getenv().NewFreeRoll == true and not drawing and not spinning then
      local cards = nil
      pcall(function() cards = (builderStore :: any).Draw().Cards or {} end)
      if type(cards) == "table" and #cards > 0 then
        local hit = false
        local hitName = ""
        for _, c in ipairs(cards) do
          local h, n = cardHit(c)
          if h then hit = true hitName = n break end
        end
        if hit then
          getenv().NewFreeRoll = false
          pcall(function() newRollToggle:Set(false) end)
          print("[new-roll] STOP: " .. hitName)
          pcall(function() storeAny.SetMessage("FRESH ROLL STOP: " .. hitName) end)
        else
          pcall(function() storeAny.Restart() end)
          task.wait(0.8)
        end
      else
        local canRoll = false
        pcall(function() canRoll = (builderStore :: any).CanRoll() end)
        if canRoll then
          pcall(function() storeAny.Roll() end)
          task.wait(0.6)
        else
          task.wait(0.5)
        end
      end
    end
    task.wait(0.15)
  end
end)
